# Explicit storage adapter: local or supabase. Supabase mode never falls back silently.
SAATHI_STORAGE=local

# Service integrations. Supabase storage is implemented; speech/extraction are implemented; messaging is upcoming.
# Copy this file to apps/web/env.local (git-ignored). Never commit env.local or paste secrets in chat.
# Restart pnpm dev after changing environment variables.

# Voice processing (server only)
SARVAM_API_KEY=
# Schema-constrained extraction (server only)
GROQ_API_KEY=

# Supabase project settings. Public URL/key may be exposed to the browser;
# the service role bypasses RLS and must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram local synthetic intake (polling; webhook secret reserved for future deployment)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Business Account: signed webhook + local worker (see docs/11)
# Meta app ID and App Secret (App settings > Basic)
WA_APP_ID=
WA_APP_SECRET=
# WhatsApp Business Account ID and the dedicated Saathi number's Phone Number ID (API Setup)
WA_BUSINESS_ACCOUNT_ID=
WA_PHONE_NUMBER_ID=
# Non-expiring system-user token with whatsapp_business_messaging + whatsapp_business_management on the WABA
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
# Only for pnpm whatsapp:register when the number is not yet on Cloud API (6-digit two-step PIN)
WA_TWO_STEP_PIN=
# Pinned Graph API version; update deliberately after compatibility testing
WA_GRAPH_VERSION=v26.0

# Optional fallbacks; leave empty until needed
BHASHINI_USER_ID=
BHASHINI_API_KEY=
GEMINI_API_KEY=

# Preferred new Supabase server key (sb_secret_...). Legacy service_role above is also supported.
SUPABASE_SECRET_KEY=

# Management API token for applying SQL, distinct from project API keys.
SUPABASE_ACCESS_TOKEN=

# Sessions are signed with this server-only secret (32+ random characters, e.g. openssl rand -hex 32).
SAATHI_SESSION_SECRET=
# Hosted mode: set to 1 to accept non-loopback hosts (Vercel). Synthetic data only.
SAATHI_PUBLIC_DEMO=
# Staff sign-up invite code for the demo organisation.
SAATHI_ORG_CODE=SAATHI-DEMO
# WhatsApp number families and staff message "LOGIN 123456" to (digits with country code).
SAATHI_WA_NUMBER=
# Serverless WhatsApp worker: keep its state in Supabase, and the shared secret for /api/worker (64 hex characters).
SAATHI_WORKER_STATE=supabase
SAATHI_WORKER_SECRET=
# Public origin of the hosted app, used by the Supabase receiver and pg_cron to wake the worker.
SAATHI_APP_URL=

# Clinical review form: private link token for the clinical lead (/review?k=...) and the results link token (/review/responses?admin=...).
SAATHI_REVIEW_TOKEN=
SAATHI_REVIEW_ADMIN_TOKEN=
