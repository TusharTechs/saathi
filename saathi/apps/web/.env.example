# Explicit storage adapter: local or supabase. Supabase mode never falls back silently.
SAATHI_STORAGE=local

# Service integrations. Supabase storage is implemented; speech/extraction are implemented; messaging is upcoming.
# Copy this file to apps/web/.env.local. Never commit .env.local or paste secrets in chat.
# Restart pnpm dev after changing environment variables.

# Voice processing (server only)
SARVAM_API_KEY=
# Schema-constrained extraction (server only)
GROQ_API_KEY=

# Supabase project settings. Public URL/key may be exposed to the browser;
# the service role bypasses RLS and must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram local synthetic intake (polling; webhook secret reserved for future deployment)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp signed webhook + local worker (live activation requires Meta test-app setup)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Pinned Graph API version; update deliberately after compatibility testing
WA_GRAPH_VERSION=v26.0

# Optional fallbacks; leave empty until needed
BHASHINI_USER_ID=
BHASHINI_API_KEY=
GEMINI_API_KEY=

# Preferred new Supabase server key (sb_secret_...). Legacy service_role above is also supported.
SUPABASE_SECRET_KEY=

# Management API token for applying SQL, distinct from project API keys.
SUPABASE_ACCESS_TOKEN=
